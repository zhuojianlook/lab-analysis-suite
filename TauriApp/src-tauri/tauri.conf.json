{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lab Analysis Suite",
  "mainBinaryName": "LabAnalysisSuite",
  "version": "0.1.0",
  "identifier": "com.zhuojianlook.analysis",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Lab Analysis Suite",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/zhuojianlook/lab-analysis-suite/updater/latest.json"
      ],
      "pubkey": "REPLACE_WITH_YOUR_MINISIGN_PUBKEY"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/api-server"
    ],
    "resources": [
      "resources/r-env"
    ]
  }
}
